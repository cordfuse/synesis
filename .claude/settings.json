{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git:*)",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(git config --global:*)",
      "Bash(git push --force*)",
      "Edit(PROTOCOL.md)",
      "Edit(CLAUDE.md)",
      "Edit(AGENTS.md)",
      "Edit(GEMINI.md)",
      "Edit(opencode.json)",
      "Edit(.github/copilot-instructions.md)",
      "Edit(skills/**)",
      "Edit(LICENSE)",
      "Edit(README.md)",
      "Edit(PLAN.md)",
      "Edit(.claude/settings.json)"
    ]
  }
}
